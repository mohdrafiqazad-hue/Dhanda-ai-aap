# ---- My Business Manager settings ----
# Is file ko copy karke ".env" naam se save karein aur values bharein.

# Dashboard kholne ka password (zaroor rakhein, warna koi bhi aapka business control kar sakta hai)
DASHBOARD_PASSWORD=apna-strong-password

# App kis address par chalega (Google OAuth redirect aur photo wali posts ke liye zaroori).
# Photo wali post ke liye ye internet par khulne wala https address hona chahiye.
BASE_URL=http://localhost:3000
PORT=3000

# Claude AI key: https://platform.claude.com se banayein
ANTHROPIC_API_KEY=

# Google Cloud OAuth client (Web application type)
# Redirect URI Google Console me daalein: <BASE_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Timezone (roz ki post kis time-zone ke hisaab se jaaye)
TZ_NAME=Asia/Kolkata
